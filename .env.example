# PlayBar Music - exemplo de variáveis de ambiente
PORT=10000
MONGO_URI=

ADMIN_USER=admin
ADMIN_PASS=

MASTER_URL=https://admplaybar.onrender.com
CLIENT_ID=
QG_COMMISSION_PERCENT=

# OAuth Mercado Pago: aplicação PlayBar (Marketplace)
# O dono do bar conecta a própria conta pelo painel /admin.html.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://playbarmusic.onrender.com/api/mercadopago/oauth/callback
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Compatibilidade temporária com integração antiga.
# Remova depois que a conta OAuth estiver conectada e validada.
MERCADOPAGO_ACCESS_TOKEN=
